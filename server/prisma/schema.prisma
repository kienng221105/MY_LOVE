generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String
  partnerName      String
  anniversaryDate  DateTime @default("2023-12-24T00:00:00.000Z")
  timerVersion      Int      @default(0)
  passwordHash     String
  avatarUrl        String?
  partnerAvatarUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  diaryEntries     DiaryEntry[]
  letters          LoveLetter[]
}

model Album {
  id        String   @id @default(uuid())
  name      String
  coverUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos    Photo[]
}

model Photo {
  id        String   @id @default(uuid())
  url       String
  title     String
  date      DateTime @default(now())
  location  String?
  caption   String?
  albumId   String?
  album     Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model MemoryMilestone {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  description String
  location    String?
  category    String   // first_meet, anniversary, travel, date_night, special
  imageUrl    String?
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model LoveLetter {
  id          String    @id @default(uuid())
  sender      String
  recipient   String
  title       String
  content     String
  sentDate    DateTime  @default(now())
  openDate    DateTime?
  isRead      Boolean   @default(false)
  isFavorite  Boolean   @default(false)
  bgStyle     String    @default("pink")
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  reactions Reaction[]
}

model DiaryEntry {
  id        String   @id @default(uuid())
  title     String
  content   String
  mood      String   // happy, romantic, cozy, miss_you
  weather   String   // sunny, rainy, starry, cloudy
  imageUrls String[]
  author    String   @default("Kien")
  isDraft   Boolean  @default(false)
  date      DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  reactions Reaction[]
}

/// Reaction (cảm xúc) của 1 user trên 1 target (thư yêu hoặc nhật ký).
/// Mỗi user chỉ có tối đa 1 reaction cho mỗi target — bấm lại để bỏ,
/// bấm emoji khác để đổi. reactionBy luôn là tên người đã bấm.
model Reaction {
  id          String      @id @default(uuid())
  type        ReactionType
  reactionBy  String      // 'Kien' | 'Love' — người đã thả cảm xúc
  targetType  ReactionTarget
  letterId    String?
  letter      LoveLetter? @relation(fields: [letterId], references: [id], onDelete: Cascade)
  diaryId     String?
  diary       DiaryEntry? @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([reactionBy, letterId])
  @@unique([reactionBy, diaryId])
  @@index([letterId])
  @@index([diaryId])
}

enum ReactionType {
  HEART
  CRY
  LAUGH
  ANGRY
  HUG
}

enum ReactionTarget {
  LETTER
  DIARY
}

model Song {
  id              String   @id @default(uuid())
  title           String
  artist          String
  albumCover      String?
  audioUrl        String
  durationSeconds Int      @default(180)
  createdAt       DateTime @default(now())
}
